<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>net.deltik.mc</groupId>
    <artifactId>libreprotect-parent</artifactId>
    <version>0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>libreprotect-egress-agent</artifactId>
  <name>LibreProtect Egress Agent</name>
  <description>
    Test-only Java agent. It records every outbound connection and DNS lookup
    the JVM attempts, with a stack trace, and blocks them. The integration
    tests use it to prove that LibreProtect makes only the network requests
    its network policy allows.
  </description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <finalName>libreprotect-egress-agent</finalName>
              <relocations>
                <!-- The server has its own ASM; never share it -->
                <relocation>
                  <pattern>org.objectweb.asm</pattern>
                  <shadedPattern>net.deltik.mc.lpit.agent.asm</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/**/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Premain-Class>net.deltik.mc.lpit.agent.EgressAgent</Premain-Class>
                    <!-- Loads the agent (and its recorder) from the bootstrap class path,
                         so instrumented java.base classes can call it -->
                    <Boot-Class-Path>libreprotect-egress-agent.jar</Boot-Class-Path>
                    <Can-Retransform-Classes>true</Can-Retransform-Classes>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
