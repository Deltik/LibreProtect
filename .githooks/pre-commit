# Refuse a commit that adds or changes a Java file or shell script without
# LibreProtect's license notice, as CI would. Enable the hooks in .githooks
# once per clone with:
#
#   git config core.hooksPath .githooks
set -euo pipefail

check="$(git rev-parse --show-toplevel)/scripts/ci/license-headers.sh"
# The check is the one in the tree being committed. A tree without it, such
# as one from before the check existed while core.hooksPath names another
# checkout's hooks, commits unchecked. Bash runs it even if the file lost its
# executable bit, which would otherwise skip the check.
[[ -f "$check" ]] || exit 0
exec bash -- "$check" --staged
