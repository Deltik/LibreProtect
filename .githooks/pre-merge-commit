# A merge that Git completes without conflicts commits without running the
# pre-commit hook, but runs this one first, with the merge's result staged.
# Run the pre-commit hook here, so that such a merge is checked too.
set -euo pipefail

exec bash -- "$(dirname -- "${BASH_SOURCE[0]}")/pre-commit"
