<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>net.deltik.mc</groupId>
    <artifactId>libreprotect-parent</artifactId>
    <version>0-SNAPSHOT</version>
  </parent>

  <artifactId>libreprotect-extensions</artifactId>
  <name>LibreProtect Extensions</name>
  <description>
    LibreProtect's implementations of CoreProtect's closed-source extension
    points: /co migrate-db and automatic purging. They reach CoreProtect only by
    reflection, by capability, so one source tree works with every upstream.
    Packaging probes the exact upstream JAR being built and writes what the
    extensions do with it to target/capabilities.tsv, which the transformer
    checks against that JAR, bundles and audits.
  </description>

  <properties>
    <!-- Must not exceed the bytecode level of upstream CoreProtect -->
    <maven.compiler.release>11</maven.compiler.release>
    <maven.compiler.testRelease>21</maven.compiler.testRelease>
  </properties>

  <build>
    <finalName>libreprotect-extensions</finalName>
    <plugins>
      <plugin>
        <!-- Probe the upstream JAR the way the extensions do at run time, and
             write what they found to target/capabilities.tsv for the
             transformer to audit. The test class path has the upstream JAR,
             the server API and the drivers; it runs with skipped tests too. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <executions>
          <execution>
            <id>capability-report</id>
            <phase>package</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>net.deltik.mc.libreprotect.extension.upstream.CapabilityReport</mainClass>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>${upstream.jar}</argument>
                <argument>${project.build.directory}/capabilities.tsv</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <!-- The upstream JAR being built (shaded, as it ships), passed by scripts/lp,
           for the tests and the capability report. The extensions' own classes
           reach it only by name, which the transformer checks. Provided by the
           plugin JAR itself at run time. -->
      <groupId>net.coreprotect</groupId>
      <artifactId>coreprotect</artifactId>
      <version>upstream</version>
      <scope>system</scope>
      <systemPath>${upstream.jar}</systemPath>
    </dependency>
    <dependency>
      <groupId>net.deltik.mc</groupId>
      <artifactId>libreprotect-runtime</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.destroystokyo.paper</groupId>
      <artifactId>paper-api</artifactId>
      <scope>provided</scope>
      <exclusions>
        <!-- Pulled in by json-simple. Surefire refuses to run with JUnit 4.10
             on the test classpath. -->
        <exclusion>
          <groupId>junit</groupId>
          <artifactId>junit</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- The server provides SQLite at run time -->
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- CoreProtect 25 downloads DuckDB through plugin.yml's libraries at run
           time, so migration finds DuckDB's appender by reflection. Tests and
           the capability report use the version CoreProtect 25 asks for. -->
      <groupId>org.duckdb</groupId>
      <artifactId>duckdb_jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- The server provides MySQL's driver at run time. Tests use it with
           the database containers, when scripts/lp passes them. -->
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- The ClickHouse client inside CoreProtect 25 logs through SLF4J,
           which the server provides at run time -->
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Renames classes of the upstream JAR, as an upstream refactoring
           would, for tests of what the extensions survive -->
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm-commons</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
