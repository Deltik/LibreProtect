# LibreProtect build entry point. CI runs exactly these commands too.
#
#   scripts/lp build                Build the upstream release pinned in upstream.lock
#   scripts/lp build --ref master   Development build of any upstream branch, tag or commit
#   scripts/lp it [--jobs N]        Integration test the last build on real Paper servers
#                                   (downloads Paper once and accepts the Minecraft EULA),
#                                   up to N at once: by default, as many as the processors
#                                   and the available memory allow.
#                                   Uses the database containers if they are up, adding
#                                   ClickHouse for the test if CoreProtect 25 needs it;
#                                   without any, starts them for the test and removes
#                                   them after.
#   scripts/lp db up [--all]        Start database containers on random loopback ports:
#                                   MySQL, and ClickHouse for CoreProtect 25 or with --all.
#                                   While they are up, build lets unit tests use them too.
#   scripts/lp db env               Print their endpoints and credentials (build/containers.env)
#   scripts/lp db down              Remove them
#   scripts/lp review [--since REF] [--full]
#                                   Show what the last build's audit found that needs review,
#                                   with the upstream commits and diffs of the files that the
#                                   findings name, since the build of the nearest upstream
#                                   line in audit/baseline.json, or since REF. --full shows
#                                   diffs of any length. Needs jq.
#   scripts/lp accept [--line NAME] [--licenses]
#                                   Once its audit findings are reviewed, accept the last
#                                   build into audit/baseline.json as the reviewed state of
#                                   its upstream line: release for a release build, else
#                                   development. --licenses accepts a change to upstream's
#                                   licensing too. Needs jq.
#   scripts/lp sources              Archive the complete source of the last build (needs a clean commit)
#   scripts/lp sbom                 Write a CycloneDX software bill of materials of the last build (needs jq)
#   scripts/lp clean                Remove build output
#   scripts/lp headers [--fix]      Check that Java, shell and Python files begin with the
#                                   license notice, or add it to those that have none
#   scripts/lp lint [--fix]         Check the Python code's format, lints and types, and that
#                                   its locked dependencies are current, or fix what Ruff can
#                                   (needs uv)
#
# Options for build:
#   --ref REF        Upstream ref to build instead of the locked release. The build
#                    is named after what git describe says about it, such as
#                    24.0-121-gd5cad31-libre-dev, while a release is named after
#                    its tag, such as 24.1-libre1.
#   --skip-tests     Skip LibreProtect's unit tests
#
# Environment:
#   JAVA_HOME        A JDK 25 or newer (with javac). Found automatically if unset.
#   LP_TEST_FORKS    How many JVMs each module runs its unit test classes in at once.
#                    By default, as many as the processors and the available memory
#                    allow, up to 8. The transformer's and the extensions' tests
#                    overlap for a few seconds, with up to twice as many JVMs then.
#
# The database containers need Docker or Podman. Images are pinned in
# integration/containers.lock.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD_DIR="$ROOT/build"
DIST_DIR="$ROOT/dist"
UPSTREAM_DIR="$BUILD_DIR/upstream"
MIN_JAVA=25

log() { printf '==> %s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

usage() {
    # The first comment after the shebang, other than the license notice
    awk 'NR == 1 { next }
        /^#/ { sub(/^# ?/, ""); text = text $0 "\n"; next }
        text ~ /^Copyright / { text = ""; next }
        { print text; exit }' "${BASH_SOURCE[0]}"
}

javac_major() {
    local version
    version="$("$1/bin/javac" -version 2>&1)" || return 1
    version="${version#javac }"
    printf '%s' "${version%%.*}"
}

find_jdk() {
    local candidate major
    local candidates=()
    [[ -n "${JAVA_HOME:-}" ]] && candidates+=("$JAVA_HOME")
    if command -v javac >/dev/null 2>&1; then
        candidates+=("$(dirname "$(dirname "$(readlink -f "$(command -v javac)")")")")
    fi
    candidates+=("$HOME"/.jdks/* /usr/lib/jvm/* /opt/*jdk* /opt/java/*)

    for candidate in "${candidates[@]}"; do
        [[ -x "$candidate/bin/javac" ]] || continue
        major="$(javac_major "$candidate")" || continue
        if [[ "$major" =~ ^[0-9]+$ ]] && (( major >= MIN_JAVA )); then
            export JAVA_HOME="$candidate"
            return 0
        fi
    done
    die "No JDK $MIN_JAVA+ with javac found. Install one or set JAVA_HOME."
}

# shellcheck source=scripts/lib/lock.sh
source "$ROOT/scripts/lib/lock.sh"

# Clone upstream into $UPSTREAM_DIR if it isn't there, and fetch its branches and tags, leaving its checkout alone.
# Returns nonzero if it can't; even so, git never falls back to the repository that build/ is in.
fetch_upstream() {
    if [[ ! -d "$UPSTREAM_DIR/.git" ]]; then
        log "Cloning $UPSTREAM_REPO"
        git clone --quiet --filter=blob:none --no-checkout "$UPSTREAM_REPO" "$UPSTREAM_DIR" || return 1
    fi
    local git=(git --git-dir="$UPSTREAM_DIR/.git")
    "${git[@]}" remote set-url origin "$UPSTREAM_REPO" || return 1
    # With every tag, including those on no branch, since builds are named after upstream's nearest release tag
    "${git[@]}" fetch --quiet --force --tags origin '+refs/heads/*:refs/remotes/origin/*' || return 1
}

# Print the commit of an upstream ref: a branch as upstream has it, or a tag or commit
upstream_ref_commit() {
    local git=(git --git-dir="$UPSTREAM_DIR/.git")
    "${git[@]}" rev-parse --verify --quiet "refs/remotes/origin/$1^{commit}" \
        || "${git[@]}" rev-parse --verify --quiet "$1^{commit}"
}

# Check out an upstream ref into $UPSTREAM_DIR and print its commit SHA
checkout_upstream() {
    local ref="$1" sha
    fetch_upstream || die "Couldn't fetch upstream from $UPSTREAM_REPO into $UPSTREAM_DIR"

    sha="$(upstream_ref_commit "$ref")" || die "Upstream ref '$ref' not found"

    git -C "$UPSTREAM_DIR" checkout --quiet --force --detach "$sha"
    git -C "$UPSTREAM_DIR" clean -xfdq
    printf '%s' "$sha"
}

# Upstream's version as its pom declares it, such as 24.1, which upstream's
# build writes into plugin.yml and CoreProtect compares as its own
upstream_version() {
    # The project version is the first <version> in upstream's pom, after the parent-less coordinates
    sed -n 's:^  <version>\(.*\)</version>.*:\1:p' "$UPSTREAM_DIR/pom.xml" | head -n 1
}

# The upstream tags that development builds are named after, as git describe
# options: v and two or three numbers, such as v24.1, which are the release
# tags that upstream-watch takes. git describe passes over any other tag, such
# as a pre-release tag or v25, for the nearest tag of this kind.
RELEASE_TAGS=(--match 'v[0-9]*.[0-9]*' --exclude 'v*[!0-9.]*' --exclude 'v*.*.*.*')

# What git describe says about the upstream checkout, given options that choose
# the tags: the nearest such tag, how many commits the checkout is past it, and
# its commit, such as v24.0-121-gd5cad31, or v24.1-0-g0af209a at the tag
# itself. The commit is abbreviated to 7 characters unless more are needed to
# tell it apart. A checkout with local changes would be named ...-dirty, but
# checkout_upstream resets the checkout first; --dirty is a safeguard.
upstream_describe() {
    git -C "$UPSTREAM_DIR" describe --tags --long --dirty --abbrev=7 "$@" \
        || die "git describe finds no upstream tag ($*) that upstream's commit $(git -C "$UPSTREAM_DIR" rev-parse --short HEAD) descends from, so the build can't be named after one. checkout_upstream fetches all of upstream's tags; build a ref from after upstream's first release tag."
}

# Check that LibreProtect's update check (ForkVersion) can read a version, and
# that a release's version fits in a Modrinth version number
check_version() {
    local version="$1" release="$2"
    # Two or three numbers, each of which fits in an int, as CoreProtect and ForkVersion parse them
    local upstream='[0-9]{1,9}\.[0-9]{1,9}(\.[0-9]{1,9})?'
    if $release; then
        [[ "$version" =~ ^${upstream}-libre[0-9]{1,9}$ ]] \
            || die "The release version $version isn't one that LibreProtect's update check reads. It reads versions named after release tags of two or three numbers, such as v24.1."
        # Only releases go to Modrinth, whose version numbers have at most 32 characters
        (( ${#version} <= 32 )) || die "The release version $version is longer than the 32 characters that Modrinth allows."
    else
        [[ "$version" =~ ^${upstream}-[0-9]{1,9}-g[0-9a-f]{7,40}(-dirty)?-libre-dev$ ]] \
            || die "The development build's version $version isn't one that LibreProtect's update check reads. It reads versions named after release tags of two or three numbers, such as v24.1."
    fi
}

# The libraries that the last upstream build's plugin.yml has servers
# download, one per line, from its top-level libraries list in block style
# (- a) or flow style ([a, b]), without quotes
upstream_plugin_libraries() {
    local plugin_yml="$UPSTREAM_DIR/target/classes/plugin.yml"
    [[ -f "$plugin_yml" ]] || die "Upstream build did not produce $plugin_yml"
    awk '
        { sub(/\r$/, "") }
        flow != "" { flow = flow " " $0 }
        flow == "" && /^libraries:/ {
            rest = $0
            sub(/^libraries:[ \t]*/, "", rest)
            if (rest !~ /^\[/) { block = 1; next }
            flow = rest
        }
        flow != "" {
            if (flow ~ /\]/) {
                sub(/^\[/, "", flow)
                sub(/\].*$/, "", flow)
                count = split(flow, items, ",")
                for (i = 1; i <= count; i++) print items[i]
                flow = ""
            }
            next
        }
        block && /^[ \t]*-/ { item = $0; sub(/^[ \t]*-/, "", item); sub(/[ \t]#.*$/, "", item); print item; next }
        block && /^[ \t]*(#.*)?$/ { next }
        { block = 0 }
    ' "$plugin_yml" | tr -d "\"' \t"
}

# The DuckDB driver version that the last upstream build's plugin.yml has
# servers download, or nothing if it has them download none
upstream_duckdb_version() {
    local libraries library version=""
    local -a coordinates
    # Command substitutions don't inherit set -e, so pass a failure on
    libraries="$(upstream_plugin_libraries)" || exit
    while IFS= read -r library; do
        # groupId:artifactId[:extension[:classifier]]:version, as Maven's resolver reads it
        IFS=: read -r -a coordinates <<<"$library"
        if (( ${#coordinates[@]} >= 3 && ${#coordinates[@]} <= 5 )) \
            && [[ "${coordinates[0]}" == org.duckdb && "${coordinates[1]}" == duckdb_jdbc ]]; then
            [[ -z "$version" ]] || die "Upstream's plugin.yml lists the DuckDB driver more than once"
            version="${coordinates[${#coordinates[@]} - 1]}"
            [[ "$version" =~ ^[0-9A-Za-z][0-9A-Za-z._-]*$ ]] \
                || die "Unexpected DuckDB version '$version' in upstream's plugin.yml"
        fi
    done <<<"$libraries"
    printf '%s' "$version"
}

# CoreProtect generation of the checked-out upstream: 25 once it has the
# multi-engine database layer (DuckDB, ClickHouse), otherwise 24. Only the
# integration test and the database containers go by it: which engines to
# test, and whether ClickHouse is needed. The build adapts to the upstream JAR
# by capability instead.
upstream_generation() {
    if [[ -f "$UPSTREAM_DIR/src/main/java/net/coreprotect/database/DatabaseType.java" ]]; then
        printf '25'
    else
        printf '24'
    fi
}

# Upstream's builds for development builds, kept by what went into them, so
# that building the same upstream commit with the same settings again takes a
# copy rather than another Maven build. Upstream's build is reproducible: it
# would give the same bytes again, which the audit baseline's lines recognize
# by their jarSha256. Releases never use them. scripts/lp clean removes them,
# like all build output.
UPSTREAM_BUILDS="$BUILD_DIR/upstream-builds"

# The settings of upstream's build of the checkout at commit $1 with the Maven
# arguments that follow, as a SHA-256: the commit, the arguments, the JDK and
# the options that the environment gives Java and Maven, the Maven version, the
# user's Maven settings and mavenrc files, and the Maven settings in
# LibreProtect's .mvn directory, which Maven finds above build/upstream too.
# What the local Maven repository already holds isn't part of it.
upstream_build_key() {
    local sha="$1" config
    shift
    {
        printf 'commit %s\n' "$sha"
        printf 'argument %s\n' "$@"
        "$JAVA_HOME/bin/java" -version 2>&1
        printf 'MAVEN_ARGS=%s\nMAVEN_OPTS=%s\n' "${MAVEN_ARGS:-}" "${MAVEN_OPTS:-}"
        printf 'JAVA_TOOL_OPTIONS=%s\nJDK_JAVA_OPTIONS=%s\n' "${JAVA_TOOL_OPTIONS:-}" "${JDK_JAVA_OPTIONS:-}"
        for config in "$ROOT"/.mvn/{wrapper/maven-wrapper.properties,maven.config,jvm.config,extensions.xml} \
            "$HOME"/.m2/{settings.xml,toolchains.xml} "$HOME/.mavenrc" /etc/mavenrc; do
            if [[ -f "$config" ]]; then
                printf 'file %s\n' "$config"
                cat "$config"
            fi
        done
    } | sha256sum | cut -d ' ' -f 1
}

# Build upstream's checkout at commit $1 with Maven and the arguments that
# follow, or restore its output from an earlier build with the same inputs
build_upstream() {
    local sha="$1" key
    key="$(upstream_build_key "$@")"
    shift
    local kept="$UPSTREAM_BUILDS/$key"
    if [[ -d "$kept/target" ]]; then
        log "Using upstream's earlier build of $sha with the same settings ($kept)"
        cp -a "$kept/target" "$UPSTREAM_DIR/target"
        if [[ -f "$kept/dependency-reduced-pom.xml" ]]; then
            cp -a "$kept/dependency-reduced-pom.xml" "$UPSTREAM_DIR/"
        fi
        return
    fi

    log "Building upstream CoreProtect unmodified"
    "$ROOT/mvnw" "$@"
    # Kept whole, so that a restored checkout looks as it does after a build
    rm -rf "$kept.new"
    mkdir -p "$kept.new"
    cp -a "$UPSTREAM_DIR/target" "$kept.new/target"
    if [[ -f "$UPSTREAM_DIR/dependency-reduced-pom.xml" ]]; then
        cp -a "$UPSTREAM_DIR/dependency-reduced-pom.xml" "$kept.new/"
    fi
    rm -rf "$kept"
    mv "$kept.new" "$kept"
}

# How many of something to run at once: one per processor that this process
# may use, but no more than $2, and no more than fit in the memory available
# now at $1 MiB each. A cgroup's limits count too, such as a container's.
parallelism() {
    local each="$1" most="$2" count memory="" cgroup="" limit used cache quota period
    # nproc counts the processors that this process may run on; macOS has sysctl instead
    count="$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null)"
    [[ "$count" =~ ^[1-9][0-9]*$ ]] || count=1
    # Memory available now, in KiB
    if [[ -r /proc/meminfo ]]; then
        memory="$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)"
    elif command -v vm_stat >/dev/null 2>&1; then
        # macOS: free, inactive and speculative pages can all be had
        memory="$(vm_stat | awk '/page size of/ { size = $8 }
            /^Pages (free|inactive|speculative):/ { pages += $NF }
            END { if (size) print int(pages * size / 1024) }')"
    fi
    # The limits of this process's cgroup (v2) and of those above it
    [[ -r /proc/self/cgroup ]] && cgroup="/sys/fs/cgroup$(sed -n 's/^0:://p' /proc/self/cgroup)"
    cgroup="${cgroup%/}"
    while [[ "$cgroup" == /sys/fs/cgroup* && -d "$cgroup" ]]; do
        if [[ -r "$cgroup/memory.max" && -r "$cgroup/memory.current" && -r "$cgroup/memory.stat" ]]; then
            read -r limit < "$cgroup/memory.max"
            read -r used < "$cgroup/memory.current"
            # Page cache that the cgroup could drop is as good as available
            cache="$(awk '$1 == "inactive_file" { n = $2 } END { print n + 0 }' "$cgroup/memory.stat")"
            if [[ "$limit" =~ ^[0-9]+$ && "$used" =~ ^[0-9]+$ && "$cache" =~ ^[0-9]+$ ]]; then
                limit=$(( (limit - used + cache) / 1024 ))
                if [[ ! "$memory" =~ ^-?[0-9]+$ ]] || (( limit < memory )); then
                    memory="$limit"
                fi
            fi
        fi
        if [[ -r "$cgroup/cpu.max" ]]; then
            read -r quota period < "$cgroup/cpu.max"
            if [[ "$quota" =~ ^[0-9]+$ && "$period" =~ ^[1-9][0-9]*$ ]] && (( (quota + period - 1) / period < count )); then
                count=$(( (quota + period - 1) / period ))
            fi
        fi
        [[ "$cgroup" != /sys/fs/cgroup ]] || break
        cgroup="${cgroup%/*}"
    done
    (( count <= most )) || count="$most"
    if [[ "$memory" =~ ^-?[0-9]+$ ]] && (( memory / 1024 / each < count )); then
        count=$(( memory / 1024 / each ))
    fi
    printf '%s' "$(( count > 0 ? count : 1 ))"
}

fork_commit() {
    local sha
    sha="$(git -C "$ROOT" rev-parse --verify --quiet HEAD 2>/dev/null)" || { printf 'uncommitted'; return; }
    if [[ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ]]; then
        sha="$sha-dirty"
    fi
    printf '%s' "$sha"
}

cmd_build() {
    local ref="" skip_tests=false
    while (( $# )); do
        case "$1" in
            # An empty ref would mean the release in upstream.lock
            --ref) [[ $# -ge 2 && -n "$2" ]] || die "--ref needs an upstream branch, tag or commit"; ref="$2"; shift 2 ;;
            --skip-tests) skip_tests=true; shift ;;
            *) die "Unknown option: $1" ;;
        esac
    done

    find_jdk
    read_lock "$ROOT/upstream.lock"
    log "Using JDK at $JAVA_HOME"

    local release=false
    if [[ -z "$ref" ]]; then
        release=true
        ref="$UPSTREAM_TAG"
    fi

    local sha
    sha="$(checkout_upstream "$ref")"
    if $release && [[ "$sha" != "$UPSTREAM_SHA" ]]; then
        die "Upstream tag $UPSTREAM_TAG now points to $sha, but upstream.lock pins $UPSTREAM_SHA. A published tag was moved; review upstream before trusting it."
    fi

    # Described before upstream's build runs, so its output can't count as local changes.
    # A release is described from its own tag, even if another tag names the same commit.
    local describe upstream_version epoch branch version
    if $release; then
        describe="$(upstream_describe --match "$UPSTREAM_TAG")"
    else
        describe="$(upstream_describe "${RELEASE_TAGS[@]}")"
    fi
    upstream_version="$(upstream_version)"
    epoch="$(git -C "$UPSTREAM_DIR" show -s --format=%ct "$sha")"
    if $release; then
        branch="libre"
        # Named after the tag, as release_tag names it for publish.sh and upstream-watch
        version="$(version_name "$UPSTREAM_TAG")-libre$FORK_REVISION"
        [[ "$describe" == "$UPSTREAM_TAG-0-g"* && "$describe" != *-dirty ]] \
            || die "git describe says upstream's checkout is $describe, rather than the tag $UPSTREAM_TAG itself. A release is built from exactly the tag in upstream.lock, without local changes."
        # The release is named after the tag, while its CoreProtect goes by the pom's version
        [[ "$upstream_version" == "$(version_name "$UPSTREAM_TAG")" ]] \
            || die "Upstream's pom.xml at $UPSTREAM_TAG declares version $upstream_version, but the tag names it $(version_name "$UPSTREAM_TAG"). The release would be called $version, while its CoreProtect would take itself for $upstream_version. Find out which version upstream released."
    else
        # CoreProtect skips its schema-version guard on branches containing "-dev"
        branch="libre-dev"
        version="$(version_name "$describe")-libre-dev"
    fi
    check_version "$version" "$release"
    log "Upstream $ref at $sha ($describe, pom.xml $upstream_version) -> LibreProtect $version"

    local upstream_args=(-B -q -f "$UPSTREAM_DIR/pom.xml" clean package
        -DskipTests
        -Dproject.branch="$branch"
        -Dproject.build.outputTimestamp="$epoch")
    if $release; then
        # A release trusts no kept build, which whatever can write to build/ could have changed
        log "Building upstream CoreProtect unmodified"
        "$ROOT/mvnw" "${upstream_args[@]}"
    else
        build_upstream "$sha" "${upstream_args[@]}"
    fi

    local original upstream_jar
    original="$(find "$UPSTREAM_DIR/target" -maxdepth 1 -name 'original-*.jar' | head -n 1)"
    upstream_jar="$(find "$UPSTREAM_DIR/target" -maxdepth 1 -name '*.jar' ! -name 'original-*' ! -name '*-sources.jar' ! -name '*-javadoc.jar' | head -n 1)"
    [[ -f "$original" && -f "$upstream_jar" ]] || die "Upstream build did not produce a shaded and an original JAR"

    # A test JVM takes 250-550 MB. The transformer's and the extensions' tests overlap for a few seconds,
    # with up to twice as many JVMs then; with 8 each, the whole build took 3.4 GB at most.
    local forks="${LP_TEST_FORKS:-$(parallelism 768 8)}"
    [[ "$forks" =~ ^[1-9][0-9]*$ ]] || die "LP_TEST_FORKS must be a positive number"

    log "Building LibreProtect"
    # The extensions' tests run against this exact upstream JAR, and packaging probes it for their capability report.
    # Modules that don't depend on each other build at the same time, and so do test classes, in $forks JVMs.
    local maven_args=(-B -q -T 1C -f "$ROOT/pom.xml" clean verify -Dproject.build.outputTimestamp="$epoch"
        -Dupstream.jar="$upstream_jar" -Dlp.test.forks="$forks")
    $skip_tests && maven_args+=(-Dmaven.test.skip=true)
    containers_healthy && maven_args+=(-Dlpit.containers="$CONTAINERS_ENV")
    local duckdb_version
    duckdb_version="$(upstream_duckdb_version)"
    if [[ -n "$duckdb_version" ]]; then
        # Servers run the DuckDB driver that upstream's plugin.yml names, not the one in LibreProtect's pom
        log "Using DuckDB $duckdb_version, which upstream's plugin.yml has servers download"
        maven_args+=(-Dduckdb.version="$duckdb_version")
    fi
    "$ROOT/mvnw" "${maven_args[@]}"

    log "Transforming"
    mkdir -p "$DIST_DIR"
    rm -f "$DIST_DIR"/LibreProtect-*.jar
    rm -f "$DIST_DIR"/*.json "$DIST_DIR"/*.md "$DIST_DIR"/*.sha256 "$DIST_DIR"/*.tar.gz
    "$JAVA_HOME/bin/java" -jar "$ROOT/transformer/target/libreprotect-transformer.jar" \
        --upstream-jar "$upstream_jar" \
        --original-jar "$original" \
        --runtime-jar "$ROOT/runtime/target/libreprotect-runtime.jar" \
        --extensions-jar "$ROOT/extensions/target/libreprotect-extensions.jar" \
        --capabilities "$ROOT/extensions/target/capabilities.tsv" \
        --translations "$UPSTREAM_DIR/lang" \
        --upstream-dir "$UPSTREAM_DIR" \
        --baseline "$ROOT/audit/baseline.json" \
        --output "$DIST_DIR/LibreProtect-$version.jar" \
        --version "$version" \
        --upstream-ref "$ref" \
        --upstream-commit "$sha" \
        --fork-commit "$(fork_commit)" \
        --timestamp "$epoch" \
        --report "$DIST_DIR/transform-report.json" \
        --differences "$DIST_DIR/DIFFERENCES.md" \
        --audit-report "$DIST_DIR/audit-report.json" \
        --observed "$DIST_DIR/audit-observed.json"

    (cd "$DIST_DIR" && sha256sum "LibreProtect-$version.jar" > "LibreProtect-$version.jar.sha256")
    printf '%s\n' "$version" > "$DIST_DIR/version.txt"
    log "Done: $DIST_DIR/LibreProtect-$version.jar"
}

cmd_it() {
    local jobs=""
    while (( $# )); do
        case "$1" in
            --jobs) [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]*$ ]] || die "--jobs needs a positive number"; jobs="$2"; shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    # A server takes up to about 1.5 GiB. Past about a dozen, no suite waits for a server anymore.
    [[ -n "$jobs" ]] || jobs="$(parallelism 1536 12)"
    find_jdk
    local fork upstream_jar generation
    fork="$(find "$DIST_DIR" -maxdepth 1 -name 'LibreProtect-*.jar' 2>/dev/null | head -n 1)"
    upstream_jar="$(find "$UPSTREAM_DIR/target" -maxdepth 1 -name '*.jar' ! -name 'original-*' ! -name '*-sources.jar' ! -name '*-javadoc.jar' 2>/dev/null | head -n 1)"
    [[ -f "$fork" && -f "$upstream_jar" ]] || die "Run scripts/lp build first"
    generation="$(upstream_generation)"

    local clickhouse=false
    [[ "$generation" == 25 ]] && clickhouse=true
    # Containers that scripts/lp db up started stay as they are, for the next test
    if [[ ! -f "$CONTAINERS_ENV" ]]; then
        trap db_down EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        db_up "$clickhouse"
    elif ! containers_healthy; then
        die "The database containers in $CONTAINERS_ENV don't respond. Start them again with scripts/lp db up, or remove them with scripts/lp db down."
    elif $clickhouse && [[ -z "$CLICKHOUSE_CONTAINER" ]]; then
        log "The database containers in $CONTAINERS_ENV lack ClickHouse, which CoreProtect $generation needs; adding it for this test"
        trap clickhouse_down EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        clickhouse_up
    else
        log "Using the database containers in $CONTAINERS_ENV"
    fi

    log "Integration testing $(basename "$fork") against $(basename "$upstream_jar") (generation $generation)"
    "$JAVA_HOME/bin/java" "$ROOT/integration/harness/Harness.java" \
        --work "$BUILD_DIR/it" \
        --paper-lock "$ROOT/integration/paper.lock" \
        --agent "$ROOT/integration/egress-agent/target/libreprotect-egress-agent.jar" \
        --it-plugin "$ROOT/integration/test-plugin/target/libreprotect-it-plugin.jar" \
        --upstream "$upstream_jar" \
        --fork "$fork" \
        --generation "$generation" \
        --containers "$CONTAINERS_ENV" \
        --jobs "$jobs"
}

# Database containers for the tests. Their names derive from $ROOT, so each
# checkout has its own. db_up writes their endpoints to $CONTAINERS_ENV as
# KEY=VALUE lines that shells can source and Java can load as properties.
CONTAINERS_ENV="$BUILD_DIR/containers.env"
CONTAINERS_KEYS=(CONTAINER_ENGINE
    MYSQL_CONTAINER MYSQL_HOST MYSQL_PORT MYSQL_DATABASE MYSQL_USERNAME MYSQL_PASSWORD MYSQL_ROOT_PASSWORD
    CLICKHOUSE_CONTAINER CLICKHOUSE_HOST CLICKHOUSE_PORT CLICKHOUSE_DATABASE CLICKHOUSE_USERNAME CLICKHOUSE_PASSWORD)

# docker or podman, whichever is installed. Podman's docker emulation counts
# as Podman.
container_engine() {
    if command -v docker >/dev/null 2>&1 && ! docker --version 2>/dev/null | grep -qi podman; then
        printf 'docker'
    elif command -v podman >/dev/null 2>&1; then
        printf 'podman'
    else
        return 1
    fi
}

container_prefix() {
    local hash
    hash="$(printf '%s' "$ROOT" | sha256sum)"
    printf 'libreprotect-%s' "${hash:0:12}"
}

# The host port that a container publishes for a container port
container_port() {
    local mapping
    mapping="$("$1" port "$2" "$3/tcp" | head -n 1)"
    [[ "$mapping" =~ :([0-9]+)$ ]] || die "Container $2 publishes no port for $3"
    printf '%s' "${BASH_REMATCH[1]}"
}

# Read integration/containers.lock into MYSQL_IMAGE and CLICKHOUSE_IMAGE.
# The file is never executed.
read_containers_lock() {
    local key value
    MYSQL_IMAGE="" CLICKHOUSE_IMAGE=""
    while IFS='=' read -r key value; do
        case "$key" in
            MYSQL_IMAGE | CLICKHOUSE_IMAGE) printf -v "$key" '%s' "$value" ;;
        esac
    done < "$ROOT/integration/containers.lock"
    [[ "$MYSQL_IMAGE" == *@sha256:* && "$CLICKHOUSE_IMAGE" == *@sha256:* ]] \
        || die "integration/containers.lock must pin MYSQL_IMAGE and CLICKHOUSE_IMAGE by digest"
}

# Read an endpoints file (default $CONTAINERS_ENV) into the $CONTAINERS_KEYS
# variables. Keys it lacks are empty. The file is never executed.
read_containers_env() {
    local file="${1:-$CONTAINERS_ENV}" key value
    for key in "${CONTAINERS_KEYS[@]}"; do
        printf -v "$key" '%s' ""
    done
    while IFS='=' read -r key value; do
        if [[ "$key" =~ ^[A-Z_]+$ && " ${CONTAINERS_KEYS[*]} " == *" $key "* ]]; then
            printf -v "$key" '%s' "$value"
        fi
    done < "$file"
}

# Probes, using the variables from read_containers_env. MySQL is probed from
# inside its container: probing the published port without logging in would
# count toward blocking the host (max_connect_errors).
mysql_ready() {
    "$CONTAINER_ENGINE" exec -e MYSQL_PWD="$MYSQL_PASSWORD" "$MYSQL_CONTAINER" \
        mysql --protocol=TCP -h127.0.0.1 -u"$MYSQL_USERNAME" -D "$MYSQL_DATABASE" -e 'SELECT 1' >/dev/null 2>&1
}

clickhouse_query() {
    curl -fsS --noproxy '*' -u "$CLICKHOUSE_USERNAME:$CLICKHOUSE_PASSWORD" \
        "http://$CLICKHOUSE_HOST:$CLICKHOUSE_PORT/" --data-binary "$1"
}

clickhouse_ready() {
    curl -fsS --noproxy '*' "http://$CLICKHOUSE_HOST:$CLICKHOUSE_PORT/ping" >/dev/null 2>&1 \
        && [[ "$(clickhouse_query 'SELECT 1' 2>/dev/null)" == 1 ]]
}

# Whether $CONTAINERS_ENV describes containers that accept connections,
# including ClickHouse if it lists ClickHouse
containers_healthy() {
    [[ -f "$CONTAINERS_ENV" ]] || return 1
    read_containers_env
    command -v "${CONTAINER_ENGINE:-none}" >/dev/null 2>&1 || return 1
    mysql_ready || return 1
    if [[ -n "$CLICKHOUSE_CONTAINER" ]]; then
        command -v curl >/dev/null 2>&1 || return 1
        clickhouse_ready || return 1
    fi
}

# Retry a probe every second for up to 3 minutes
await() {
    local what="$1" deadline=$((SECONDS + 180))
    shift
    log "Waiting for $what to accept connections"
    until "$@"; do
        (( SECONDS < deadline )) || die "$what did not accept connections within 3 minutes"
        sleep 1
    done
}

# Start fresh database containers, replacing any this checkout started
# before: MySQL, and ClickHouse if $1 is true. Each gets a database named
# coreprotect, and a user coreprotect that owns it, with a random password.
# Write $CONTAINERS_ENV once they accept connections.
db_up() {
    local clickhouse="$1" engine prefix password
    engine="$(container_engine)" \
        || die "The integration test runs its databases in containers. Install Docker or Podman."
    if $clickhouse; then
        command -v curl >/dev/null 2>&1 || die "Probing ClickHouse needs curl"
    fi
    read_containers_lock
    db_down
    prefix="$(container_prefix)"
    password="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
    local label="net.deltik.libreprotect.checkout=$ROOT"

    log "Starting MySQL in container $prefix-mysql"
    "$engine" run -d --name "$prefix-mysql" --label "$label" -p 127.0.0.1::3306 \
        -e MYSQL_ROOT_PASSWORD="$password" -e MYSQL_DATABASE=coreprotect \
        -e MYSQL_USER=coreprotect -e MYSQL_PASSWORD="$password" \
        "$MYSQL_IMAGE" >/dev/null
    if $clickhouse; then
        run_clickhouse "$engine" "$prefix" "$password"
    fi

    local published_mysql published_clickhouse=""
    published_mysql="$(container_port "$engine" "$prefix-mysql" 3306)"
    if $clickhouse; then
        published_clickhouse="$(container_port "$engine" "$prefix-clickhouse" 8123)"
    fi

    mkdir -p "$BUILD_DIR"
    local pending="$CONTAINERS_ENV.new"
    (
        umask 077
        {
            printf '# Database containers for the tests, from scripts/lp db up. Remove them with scripts/lp db down.\n'
            printf 'CONTAINER_ENGINE=%s\n' "$engine"
            printf 'MYSQL_CONTAINER=%s\n' "$prefix-mysql"
            printf 'MYSQL_HOST=127.0.0.1\nMYSQL_PORT=%s\n' "$published_mysql"
            printf 'MYSQL_DATABASE=coreprotect\nMYSQL_USERNAME=coreprotect\n'
            printf 'MYSQL_PASSWORD=%s\nMYSQL_ROOT_PASSWORD=%s\n' "$password" "$password"
            if $clickhouse; then
                clickhouse_endpoints "$prefix" "$published_clickhouse" "$password"
            fi
        } > "$pending"
    )
    read_containers_env "$pending"

    await MySQL mysql_ready
    if $clickhouse; then
        prepare_clickhouse
    fi
    mv "$pending" "$CONTAINERS_ENV"
    log "Database containers are up: $CONTAINERS_ENV"
}

# Start ClickHouse in this checkout's container, with a database named
# coreprotect and a user coreprotect that owns it, whose password is $3
run_clickhouse() {
    local engine="$1" prefix="$2" password="$3"
    log "Starting ClickHouse in container $prefix-clickhouse"
    "$engine" run -d --name "$prefix-clickhouse" --label "net.deltik.libreprotect.checkout=$ROOT" -p 127.0.0.1::8123 \
        -e CLICKHOUSE_DB=coreprotect -e CLICKHOUSE_USER=coreprotect -e CLICKHOUSE_PASSWORD="$password" \
        -e CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1 \
        "$CLICKHOUSE_IMAGE" >/dev/null
}

# The lines of $CONTAINERS_ENV for the ClickHouse container that run_clickhouse
# started, which publishes port $2
clickhouse_endpoints() {
    local prefix="$1" port="$2" password="$3"
    printf '# ClickHouse over HTTP, which CoreProtect uses\n'
    printf 'CLICKHOUSE_CONTAINER=%s\n' "$prefix-clickhouse"
    printf 'CLICKHOUSE_HOST=127.0.0.1\nCLICKHOUSE_PORT=%s\n' "$port"
    printf 'CLICKHOUSE_DATABASE=coreprotect\nCLICKHOUSE_USERNAME=coreprotect\n'
    printf 'CLICKHOUSE_PASSWORD=%s\n' "$password"
}

# Wait for the ClickHouse in the variables from read_containers_env, and
# prepare its database
prepare_clickhouse() {
    await ClickHouse clickhouse_ready
    # CoreProtect needs a database with UUID-backed table identities, which Atomic has
    clickhouse_query "CREATE DATABASE IF NOT EXISTS $CLICKHOUSE_DATABASE ENGINE = Atomic" >/dev/null
}

# Add ClickHouse to the containers in $CONTAINERS_ENV, which lack it, leaving
# the others as they are. clickhouse_down removes it again.
clickhouse_up() {
    local prefix password published
    command -v curl >/dev/null 2>&1 || die "Probing ClickHouse needs curl"
    read_containers_lock
    read_containers_env
    local engine="$CONTAINER_ENGINE"
    prefix="$(container_prefix)"
    # $CONTAINERS_ENV doesn't list it, so it's left over from a test that didn't finish
    if "$engine" container inspect "$prefix-clickhouse" >/dev/null 2>&1; then
        "$engine" rm -f -v "$prefix-clickhouse" >/dev/null
    fi
    password="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
    run_clickhouse "$engine" "$prefix" "$password"
    published="$(container_port "$engine" "$prefix-clickhouse" 8123)"

    local pending="$CONTAINERS_ENV.new"
    (
        umask 077
        { cat "$CONTAINERS_ENV"; clickhouse_endpoints "$prefix" "$published" "$password"; } > "$pending"
    )
    read_containers_env "$pending"
    prepare_clickhouse
    mv "$pending" "$CONTAINERS_ENV"
    log "ClickHouse is up: $CONTAINERS_ENV"
}

# Remove the ClickHouse container that clickhouse_up added, and its endpoints
clickhouse_down() {
    local engine name
    name="$(container_prefix)-clickhouse"
    rm -f "$CONTAINERS_ENV.new"
    if [[ -f "$CONTAINERS_ENV" ]]; then
        (
            umask 077
            grep -v -e '^CLICKHOUSE_' -e '^# ClickHouse over HTTP' "$CONTAINERS_ENV" > "$CONTAINERS_ENV.new" || true
        )
        mv "$CONTAINERS_ENV.new" "$CONTAINERS_ENV"
    fi
    engine="$(container_engine)" || return 0
    if "$engine" container inspect "$name" >/dev/null 2>&1; then
        log "Removing container $name"
        "$engine" rm -f -v "$name" >/dev/null
    fi
}

# Remove the database containers of this checkout and their endpoints
db_down() {
    local engine name
    rm -f "$CONTAINERS_ENV" "$CONTAINERS_ENV.new"
    engine="$(container_engine)" || return 0
    for name in "$(container_prefix)-mysql" "$(container_prefix)-clickhouse"; do
        if "$engine" container inspect "$name" >/dev/null 2>&1; then
            log "Removing container $name"
            "$engine" rm -f -v "$name" >/dev/null
        fi
    done
}

cmd_db() {
    local action="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "$action" in
        up)
            local clickhouse=false
            [[ "$(upstream_generation)" == 25 ]] && clickhouse=true
            while (( $# )); do
                case "$1" in
                    --all) clickhouse=true; shift ;;
                    *) die "Unknown option: $1" ;;
                esac
            done
            db_up "$clickhouse"
            ;;
        env)
            [[ $# -eq 0 ]] || die "Unknown option: $1"
            [[ -f "$CONTAINERS_ENV" ]] || die "No database containers. Start them with scripts/lp db up."
            log "$CONTAINERS_ENV"
            cat "$CONTAINERS_ENV"
            ;;
        down)
            [[ $# -eq 0 ]] || die "Unknown option: $1"
            db_down
            ;;
        *) die "Unknown db command: ${action:-(none)} (try --help)" ;;
    esac
}

# The complete source of the last build, as the GPL requires for each JAR:
# LibreProtect at the commit it was built from and CoreProtect at the upstream
# commit it was built from.
cmd_sources() {
    local report="$DIST_DIR/transform-report.json"
    [[ -f "$DIST_DIR/version.txt" && -f "$report" ]] || die "Run scripts/lp build first"

    local version upstream_commit fork_commit
    version="$(cat "$DIST_DIR/version.txt")"
    upstream_commit="$(sed -n 's/^ *"upstreamCommit": "\([0-9a-f]\{40\}\)",*$/\1/p' "$report")"
    fork_commit="$(sed -n 's/^ *"forkCommit": "\(.*\)",*$/\1/p' "$report")"
    [[ -n "$upstream_commit" ]] || die "No upstream commit in $report"
    [[ "$fork_commit" =~ ^[0-9a-f]{40}$ ]] \
        || die "The last build was made from '$fork_commit', not a clean commit. Commit, rebuild, then archive, so the source matches the JAR."

    local top="LibreProtect-$version-sources"
    local archive="$DIST_DIR/$top.tar"
    local readme="LibreProtect $version, built from:
  libreprotect/  LibreProtect at commit $fork_commit
  coreprotect/   CoreProtect at commit $upstream_commit

To rebuild, see libreprotect/README.md: libreprotect/scripts/lp build clones
CoreProtect at the pinned commit, which is the source in coreprotect/.
Licenses: libreprotect/LICENSE (GPL-3.0-or-later), libreprotect/NOTICE, and
coreprotect/LICENSE (Artistic-2.0).
"
    rm -f "$archive" "$archive.gz"
    # The virtual file comes before any --prefix, so its path is used exactly as given
    git -C "$ROOT" archive --format=tar \
        --add-virtual-file="$top/README.txt:$readme" \
        --prefix="$top/libreprotect/" -o "$archive" "$fork_commit"
    # Upstream's files as the audit read them: its .gitattributes may neither leave files out (export-ignore),
    # such as its LICENSE, nor rewrite them (export-subst). The repository's own attributes file overrides it.
    local attributes
    attributes="$(git -C "$UPSTREAM_DIR" rev-parse --path-format=absolute --git-path info/attributes)"
    mkdir -p "$(dirname "$attributes")"
    printf '* -export-ignore -export-subst\n' > "$attributes"
    git -C "$UPSTREAM_DIR" archive --format=tar --prefix="$top/coreprotect/" -o "$archive.upstream" "$upstream_commit"
    tar --concatenate --file="$archive" "$archive.upstream"
    rm -f "$archive.upstream"
    gzip -9n "$archive"
    log "Done: $archive.gz"
}

# A CycloneDX software bill of materials of the last build: upstream's
# dependencies that the JAR contains, and the libraries that its plugin.yml
# has the server download when it loads the plugin, such as CoreProtect 25's
# DuckDB driver. The dependencies that the server provides are left out:
# those that upstream's pom marks provided, and those that upstream's build
# leaves out of the JAR, such as Log4j and SLF4J, whose copies on the server
# the plugin uses. The transformer's BundledComponents finds the latter by
# comparing the JAR's files with the dependencies' files, rather than by
# reading upstream's build settings; it keeps a dependency that it can't
# compare, such as one of system scope, and warns about it.
cmd_sbom() {
    [[ $# -eq 0 ]] || die "Unknown option: $1"
    local report="$DIST_DIR/transform-report.json" observed="$DIST_DIR/audit-observed.json"
    local transformer="$ROOT/transformer/target/libreprotect-transformer.jar"
    [[ -f "$DIST_DIR/version.txt" && -f "$report" && -f "$observed" && -f "$transformer" ]] \
        || die "Run scripts/lp build first"
    command -v jq >/dev/null 2>&1 || die "The software bill of materials needs jq"

    local version upstream_commit
    version="$(cat "$DIST_DIR/version.txt")"
    upstream_commit="$(jq -r .upstreamCommit "$report")"
    [[ "$(git -C "$UPSTREAM_DIR" rev-parse HEAD 2>/dev/null)" == "$upstream_commit" ]] \
        || die "$UPSTREAM_DIR is no longer at $upstream_commit, which the last build was made from. Rebuild first."
    local original upstream_jar
    original="$(find "$UPSTREAM_DIR/target" -maxdepth 1 -name 'original-*.jar' 2>/dev/null | head -n 1)"
    upstream_jar="$(find "$UPSTREAM_DIR/target" -maxdepth 1 -name '*.jar' ! -name 'original-*' ! -name '*-sources.jar' ! -name '*-javadoc.jar' 2>/dev/null | head -n 1)"
    [[ -f "$original" && -f "$upstream_jar" ]] || die "Run scripts/lp build first"

    find_jdk
    local bom="$UPSTREAM_DIR/target/sbom.json" output="$DIST_DIR/LibreProtect-$version.cdx.json"
    local dependencies="$UPSTREAM_DIR/target/sbom-dependencies" outside="$UPSTREAM_DIR/target/sbom-outside.json"
    rm -rf "$bom" "$dependencies" "$outside"
    "$ROOT/mvnw" -B -q -f "$UPSTREAM_DIR/pom.xml" org.cyclonedx:cyclonedx-maven-plugin:2.9.3:makeBom \
        -DoutputFormat=json -DoutputName=sbom -DincludeTestScope=false -DincludeProvidedScope=false
    [[ -f "$bom" ]] || die "The CycloneDX Maven plugin did not write $bom"
    # The same dependencies' files, to compare with the JAR's
    "$ROOT/mvnw" -B -q -f "$UPSTREAM_DIR/pom.xml" org.apache.maven.plugins:maven-dependency-plugin:3.9.0:copy-dependencies \
        -DincludeScope=runtime -Dmdep.useRepositoryLayout=true -DoutputDirectory="$dependencies"
    log "Finding which of upstream's dependencies $(basename "$upstream_jar") contains"
    "$JAVA_HOME/bin/java" -cp "$transformer" net.deltik.mc.libreprotect.transformer.BundledComponents \
        --bom "$bom" --jar "$upstream_jar" --original-jar "$original" --dependencies "$dependencies" \
        --output "$outside"

    # The audit read the libraries from the JAR's plugin.yml, which the transformer leaves as it is.
    # Each is groupId:artifactId[:extension[:classifier]]:version, as Maven's resolver reads it.
    # Coordinates that name the same file, such as g:a:1 and g:a:jar:1, become one component.
    # A dependency that the JAR leaves out but plugin.yml lists is downloaded, and so kept as required.
    jq --slurpfile observed "$observed" --slurpfile outside "$outside" \
        --arg downloaded_description "Not in the JAR: plugin.yml lists it in libraries, so the server downloads it when it loads the plugin" '
        .metadata.component["bom-ref"] as $root
        | [.components[]?.purl] as $listed
        | ([$observed[0].pluginLibraries[]
            | split(":") as $coordinates
            | ($coordinates | length) as $parts
            | if $parts < 3 or $parts > 5 or any($coordinates[]; . == "")
                then error("Unexpected library in plugin.yml: \(.)") else . end
            | ("pkg:maven/\($coordinates[0])/\($coordinates[1])@\($coordinates[$parts - 1])?"
                + (if $parts == 5 then "classifier=\($coordinates[3])&" else "" end)
                + "type=\(if $parts >= 4 then $coordinates[2] else "jar" end)") as $purl
            | {type: "library", "bom-ref": $purl, group: $coordinates[0], name: $coordinates[1],
               version: $coordinates[$parts - 1], scope: "required", purl: $purl,
               description: $downloaded_description}
          ] | unique_by(.["bom-ref"])) as $libraries
        | [$libraries[] | select(.purl as $purl | any($listed[]; . == $purl) | not)] as $downloaded
        | [(.components // [])[]
            | select(.purl as $purl | any($outside[0][]; . == $purl) and (any($libraries[]; .purl == $purl) | not))
            | .["bom-ref"]] as $omitted
        | .components = [(.components // [])[]
            | select(.["bom-ref"] as $ref | any($omitted[]; . == $ref) | not)
            | .purl as $purl
            | if any($outside[0][]; . == $purl) then .scope = "required" | .description = $downloaded_description
              else . end]
            + $downloaded
        | .dependencies = [(.dependencies // [])[]
            | select(.ref as $ref | any($omitted[]; . == $ref) | not)
            | .dependsOn = [(.dependsOn // [])[] | select(. as $ref | any($omitted[]; . == $ref) | not)]
            | if .ref == $root then .dependsOn += [$downloaded[]["bom-ref"]] else . end]
            + [$downloaded[] | {ref: .["bom-ref"], dependsOn: []}]
    ' "$bom" > "$output.new"
    mv "$output.new" "$output"
    log "Done: $output"
}

cmd_clean() {
    rm -rf "$BUILD_DIR" "$DIST_DIR"
    find "$ROOT" -maxdepth 3 -name target -type d -prune -exec rm -rf {} +
}

# How many lines of one file's diff review shows, unless --full
REVIEW_DIFF_LINES=400

# Print stdin in a Markdown code block, with the info string $1, fenced by
# more backquotes than any run of them in it, so that nothing in it can end
# the block: upstream's files are untrusted, and have Markdown of their own
markdown_block() {
    local text fence
    text="$(cat)"
    fence="$(awk '{ while (match($0, /`+/)) { if (RLENGTH > longest) longest = RLENGTH; $0 = substr($0, RSTART + RLENGTH) } }
        END { for (i = 0; i < (longest < 3 ? 3 : longest + 1); i++) printf "`" }' <<<"$text")"
    printf '%s%s\n%s\n%s\n' "$fence" "$1" "$text" "$fence"
}

# Escape what would be HTML, a link or a code span in stdin's Markdown, such as upstream's commit messages
markdown_escape() {
    sed 's/[\\<>&`[]/\\&/g; s/]/\\]/g' | tr -d '\000-\010\013-\037'
}

# Keep the hunks of a diff on stdin that fit in $1 lines, after its header: first those that name one of the
# methods in $2, one per line, as a hunk's header names the method that it's in, then the others. Prints how many
# lines it left out last, on a line of its own.
select_hunks() {
    NAMES="$2" awk -v max="$1" '
        BEGIN { count = split(ENVIRON["NAMES"], names, "\n") }
        /^@@/ { hunk++ }
        { if (hunk == 0) { header = header $0 "\n"; used++ } else { text[hunk] = text[hunk] $0 "\n"; size[hunk]++ } }
        END {
            for (pass = 1; pass <= 2; pass++) {
                for (i = 1; i <= hunk; i++) {
                    named = 0
                    for (j = 1; j <= count; j++) if (names[j] != "" && index(text[i], names[j] "(")) named = 1
                    if ((pass == 1) != named || chosen[i]) continue
                    if (used + size[i] <= max) { chosen[i] = 1; used += size[i] } else left += size[i]
                }
            }
            printf "%s", header
            for (i = 1; i <= hunk; i++) if (chosen[i]) printf "%s", text[i]
            print left + 0
        }'
}

# Show what the last build's audit found that needs a maintainer, and what
# changed upstream that the findings point to: the commits and diffs of the
# upstream files that they name, since the build that the nearest line of the
# audit baseline was accepted from, or since --since. A diff shows whole
# methods where it's short enough, and otherwise, first the parts that name
# the findings' methods. Markdown, for a terminal or a CI summary.
# shellcheck disable=SC2016 # Backquotes in single quotes are Markdown's
cmd_review() {
    local since="" full=false
    while (( $# )); do
        case "$1" in
            --since)
                (( $# >= 2 )) || die "--since needs an upstream commit"
                since="$2"
                shift 2
                ;;
            --full) full=true; shift ;;
            *) die "Unknown option for review: $1" ;;
        esac
    done
    command -v jq >/dev/null 2>&1 || die "review needs jq"
    local report="$DIST_DIR/audit-report.json" transform="$DIST_DIR/transform-report.json" \
        baseline="$ROOT/audit/baseline.json"
    [[ -f "$report" && -f "$transform" ]] \
        || die "No audited build in $DIST_DIR: run scripts/lp build, or download a CI run's dist artifact into it"
    read_lock "$ROOT/upstream.lock"
    fetch_upstream || log "Couldn't fetch upstream; reviewing with what $UPSTREAM_DIR has"
    [[ -d "$UPSTREAM_DIR/.git" ]] || die "No upstream repository at $UPSTREAM_DIR"
    # Upstream's repository, and never the one that build/ is in; paths from findings are paths, not patterns
    local git=(git --literal-pathspecs --git-dir="$UPSTREAM_DIR/.git") built
    built="$(jq -r .upstreamCommit "$transform")"
    "${git[@]}" cat-file -e "$built^{commit}" 2>/dev/null || die "Upstream has no commit $built, which was built"

    # What to compare the build with: --since, or the commit that the nearest line was accepted from
    local base="" base_line="" name commit distance best=""
    if [[ -n "$since" ]]; then
        base="$(upstream_ref_commit "$since")" || die "Upstream has no ref or commit $since"
    else
        while IFS=$'\t' read -r name commit; do
            "${git[@]}" cat-file -e "$commit^{commit}" 2>/dev/null || continue
            if "${git[@]}" merge-base --is-ancestor "$commit" "$built"; then
                distance="$("${git[@]}" rev-list --count "$commit..$built")"
            else
                # Such as a release that upstream tagged on a branch of its own: after every ancestor
                distance=$(( 1000000 + $("${git[@]}" rev-list --count "$commit...$built") ))
            fi
            if [[ -z "$best" ]] || (( distance < best )); then
                best="$distance" base="$commit" base_line="$name"
            fi
        done < <(jq -r '.lines // {} | to_entries[] | select(.value.upstream.commit | type == "string")
            | "\(.key)\t\(.value.upstream.commit)"' "$baseline")
    fi

    local short_built short_base=""
    short_built="$("${git[@]}" rev-parse --short=7 "$built")"
    printf '# Audit of LibreProtect %s\n\n' "$(jq -r .forkVersion "$transform")"
    if [[ -z "$base" ]]; then
        printf 'Upstream `%s`. No line of the audit baseline names an upstream commit to compare it with.\n\n' \
            "$short_built"
    else
        local web="${UPSTREAM_REPO%.git}" what=""
        short_base="$("${git[@]}" rev-parse --short=7 "$base")"
        [[ -z "$base_line" ]] || what=", which the $base_line line was accepted from"
        printf 'Upstream `%s`, compared with `%s`%s: %s commits since, %s before.' "$short_built" "$short_base" \
            "$what" "$("${git[@]}" rev-list --count "$base..$built")" "$("${git[@]}" rev-list --count "$built..$base")"
        [[ "$web" == https://github.com/* ]] && printf ' [Compare on GitHub](%s/compare/%s...%s)' "$web" "$base" "$built"
        printf '\n\n'
    fi

    if ! jq -e '[.findings[] | select(.severity != "INFO")] | length > 0' "$report" >/dev/null; then
        printf 'The audit found nothing that needs review.\n'
        return
    fi
    # Sites and details come from upstream: as code spans that nothing in them ends, and as text without HTML,
    # links or code spans
    local markdown='
        def printable: gsub("[[:cntrl:]]"; "?");
        def code: printable | ([scan("`+") | length] | max // 0) as $longest | ("`" * ($longest + 1)) as $fence
            | if $longest > 0 then "\($fence) \(.) \($fence)" else "\($fence)\(.)\($fence)" end;
        def text: printable | gsub("(?<c>[\\\\<>&`\\[\\]])"; "\\\(.c)");'
    local findings='[.findings[] | select(.severity != "INFO")] | sort_by(.severity != "FAIL", .rule == "capability-change")[]'
    printf '## Findings\n\n'
    jq -r "$markdown $findings"'
        | "- **\(.severity)** \(.rule) at \(.site | code), resolved by "
            + (if .resolution == "ACCEPT" then "accepting the build" else "an allowance or a fix" end)
            + ": \(.detail | text)"' "$report"
    printf '\n'
    [[ -n "$base" ]] || return 0

    # Where upstream changed what each finding names: a file to diff, or a string to find; and the finding's site
    # as a code span, and the name of the method that it names, if any
    local subjects
    subjects="$(jq -r "$markdown $findings"'
        | def source: "src/main/java/" + (split("#")[0] | split("$")[0]) + ".java";
          def method: capture("(?<owner>[^ ]*)#(?<name>[^(]+)\\(") // null
              | if . == null or .name == "<clinit>" then "" elif .name == "<init>"
                then .owner | split("/")[-1] | split("$")[-1] else .name end;
        .site as $site
        | if .rule == "capability-change" then
              ($site | capture("^(?<kind>[a-z]+) (?:(?<way>\\S+) )?(?<subject>.+)$")) as $key
              | if $key.kind == "doc" then ["file", $key.subject]
                elif ($key.kind | IN("code", "optional", "enum")) then ["file", ($key.subject | source)]
                else empty end
          elif (.rule | IN("dependency-change", "repository-change", "build-plugin-change", "profile-change",
              "new-library-package")) then ["file", "pom.xml"]
          elif .rule == "plugin-libraries-change" then ["file", "src/main/resources/plugin.yml"]
          elif .rule == "license-change" then ["file", $site]
          elif (.rule | IN("new-host", "new-extension-point")) then ["string", $site]
          elif .rule == "extension-not-requested" then ["file", ("net/coreprotect/utility/Extensions" | source)]
          elif ($site | test("^[A-Za-z_$][A-Za-z0-9_$]*(/[A-Za-z_$][A-Za-z0-9_$]*)+(#|$)")) then
              ["file", ($site | source)]
          else empty end
        | select(.[1] | test("[[:cntrl:]]") | not)
        | . + [($site | code), ($site | method | printable)] | join("\t")' "$report")"
    [[ -n "$subjects" ]] || return 0

    printf '## What Changed Upstream\n'
    local attributes errors kind subject sites names commits diff at_base at_built left
    attributes="$(mktemp)"
    errors="$(mktemp)"
    printf '*.java diff=java\n' > "$attributes"
    while IFS=$'\t' read -r kind subject; do
        sites="$(awk -F '\t' -v kind="$kind" -v subject="$subject" '$1 == kind && $2 == subject { print $3 }' \
            <<<"$subjects" | awk '!seen[$0]++' | paste -sd ',' - | sed 's/,/, /g')"
        names="$(awk -F '\t' -v kind="$kind" -v subject="$subject" '$1 == kind && $2 == subject && $4 != "" { print $4 }' \
            <<<"$subjects" | awk '!seen[$0]++')"
        printf '\n### %s\n\nFor %s\n\n' "$(jq -rn --arg subject "$subject" "$markdown"' $subject | code')" "$sites"

        if [[ "$kind" == string ]]; then
            # The commits that added or removed it, and where the built upstream's code has it, as the audit found it
            # in any case; code may still build it from parts
            log "Looking for $subject in upstream's code, which may fetch its files first"
            if commits="$("${git[@]}" log -S"$subject" --format='- %h %s' "$base..$built" -- src/main 2>"$errors" \
                | markdown_escape)"; then
                [[ -z "$commits" ]] || printf '%s\n\n' "$commits"
            fi
            local status=0
            diff="$("${git[@]}" grep -n -i -F -e "$subject" "$built" -- src/main 2>"$errors" | sed "s/^$built://")" \
                || status=$?
            if (( status == 0 )); then
                awk 'NR <= 20' <<<"$diff" | tr -d '\000-\010\013-\037' | markdown_block ""
            elif (( status == 1 )); then
                printf "Upstream's code at \`%s\` doesn't have it as it is, which it may build from parts.\n" "$short_built"
            else
                printf "Couldn't search upstream's code: %s\n" "$(head -n 1 "$errors")"
            fi
            continue
        fi

        at_base="$("${git[@]}" ls-tree --name-only "$base" -- "$subject" 2>/dev/null)"
        at_built="$("${git[@]}" ls-tree --name-only "$built" -- "$subject" 2>/dev/null)"
        if [[ -z "$at_base" && -z "$at_built" ]]; then
            printf 'Upstream has no such file at `%s` or `%s`, as for a bundled library.\n' "$short_base" "$short_built"
            continue
        fi
        if commits="$("${git[@]}" log --format='- %h %s' "$base..$built" -- "$subject" 2>"$errors" | markdown_escape)"
        then
            [[ -z "$commits" ]] || printf '%s\n\n' "$commits"
        fi
        # Whole methods if that isn't too long, else first the parts that name the findings' methods
        if ! diff="$("${git[@]}" -c core.attributesFile="$attributes" diff --function-context "$base" "$built" \
            -- "$subject" 2>"$errors")"; then
            printf "Couldn't compare it: %s\n" "$(head -n 1 "$errors")"
            continue
        fi
        if [[ -z "$diff" ]]; then
            printf 'Upstream has no change to it between `%s` and `%s`. A fingerprint changes with code that the compiler copied into its method from another class too, such as a constant.\n' \
                "$short_base" "$short_built"
            continue
        fi
        left=0
        if ! $full && (( $(wc -l <<<"$diff") > REVIEW_DIFF_LINES )); then
            diff="$("${git[@]}" -c core.attributesFile="$attributes" diff -U10 "$base" "$built" -- "$subject" \
                | select_hunks "$REVIEW_DIFF_LINES" "$names")"
            left="$(tail -n 1 <<<"$diff")"
            diff="$(sed '$d' <<<"$diff")"
        fi
        markdown_block diff <<<"$diff"
        (( left == 0 )) || printf '\n%s more lines not shown; scripts/lp review --full shows them.\n' "$left"
    done < <(cut -f 1,2 <<<"$subjects" | awk '!seen[$0]++')
    rm -f "$attributes" "$errors"
}

# Accept the last build into the audit baseline, once a maintainer has
# reviewed what its audit found: its upstream line's reviewed state becomes
# what the build observed. That resolves each finding whose resolution is
# ACCEPT. A FAIL whose resolution is ALLOW needs a fix, or an allowance with a
# reason, first; so does a REVIEW whose resolution is ALLOW, which this only
# lists. A change to upstream's licensing fails every build, and is accepted
# only with --licenses, once a maintainer is sure that LibreProtect may still
# distribute CoreProtect.
cmd_accept() {
    local line="" licenses=false
    while (( $# )); do
        case "$1" in
            --line)
                (( $# >= 2 )) || die "--line needs a name, such as release or development"
                line="$2"
                shift 2
                ;;
            --licenses) licenses=true; shift ;;
            *) die "Unknown option for accept: $1" ;;
        esac
    done
    command -v jq >/dev/null 2>&1 || die "accept needs jq"
    local baseline="$ROOT/audit/baseline.json" report="$DIST_DIR/audit-report.json" \
        observed="$DIST_DIR/audit-observed.json" transform="$DIST_DIR/transform-report.json"
    [[ -f "$report" && -f "$observed" && -f "$transform" ]] \
        || die "No audited build in $DIST_DIR: run scripts/lp build, or download a CI run's dist artifact into it"
    jq -e '.upstream.commit | type == "string"' "$observed" >/dev/null \
        || die "$observed is from a build before the baseline had lines; build again"
    local built
    built="$(jq -r .upstream.commit "$observed")"
    [[ "$built" == "$(jq -r .upstreamCommit "$transform")" ]] \
        || die "$observed and $transform are of different builds; build again"

    if [[ -z "$line" ]]; then
        # A release build, or any build of the commit that upstream.lock pins, is of the release line
        read_lock "$ROOT/upstream.lock"
        if [[ "$(jq -r .forkVersion "$transform")" != *-libre-dev || "$built" == "$UPSTREAM_SHA" ]]; then
            line=release
        else
            line=development
        fi
    fi
    [[ "$line" =~ ^[a-z0-9][a-z0-9.-]*$ ]] || die "A line's name is made of lowercase letters, digits, '.' and '-'"

    # The findings that remain after accepting: those that accepting doesn't resolve, unless an allowance in the
    # baseline now covers them, matched as the audit matches it, since what the build observed doesn't depend on it
    # shellcheck disable=SC2016 # A jq program, whose variables are jq's
    local remaining='($baseline[0].allow // []) as $allow
        | def allowed: . as $finding | any($allow[]; . as $allowance | $allowance.rule == $finding.rule
            and (if $allowance.site | endswith("*") then $finding.site | startswith($allowance.site[:-1])
            else $allowance.site == $finding.site end));
        .findings[] | select(.resolution != "ACCEPT" and (allowed | not))'
    local findings
    findings="$(jq -r --slurpfile baseline "$baseline" "$remaining"' | select(.severity == "FAIL")
        | "  \(.rule) at \(.site): \(.detail)"' "$report")"
    [[ -z "$findings" ]] || die "The audit failed, which accepting the build doesn't resolve. Fix it and build again, or add an allowance with a reason to audit/baseline.json and accept the build then:
$findings"
    if ! $licenses; then
        findings="$(jq -r '.findings[] | select(.severity == "FAIL" and .resolution == "ACCEPT")
            | "  \(.rule) at \(.site): \(.detail)"' "$report")"
        [[ -z "$findings" ]] || die "Upstream's licensing changed. Once you're sure that LibreProtect may still distribute CoreProtect under the GPL, as section 4(c)(ii) of the Artistic License 2.0 allows, accept the build with --licenses:
$findings"
    fi

    # The ways that the line takes now and didn't before, which the extensions' exact tests will expect on the JAR
    local ways
    ways="$(jq -r --arg line "$line" --slurpfile observed "$observed" '
        [(.lines[$line].capabilities // [])[] | select(startswith("capability "))] as $old
        | [$observed[0].capabilities[] | select(startswith("capability "))] - $old | .[] | "  \(.)"' "$baseline")"

    local accepted
    accepted="$(mktemp)"
    jq --arg line "$line" --slurpfile observed "$observed" \
        '.lines[$line] = $observed[0] | .lines |= (to_entries | sort_by(.key) | from_entries)' \
        "$baseline" > "$accepted"
    # What the line accepted before, and what it accepts now: each entry, unless the line is new
    jq -r --arg line "$line" --slurpfile before "$baseline" '
        def build: if .ref == .commit then .commit[:12] else "\(.ref) (\(.commit[:12]))" end;
        ($before[0].lines[$line] // {}) as $old | .lines[$line] as $new
        | "==> Accepted upstream \($new.upstream | build) as the \($line) line"
            + (if $old.upstream then ", which was \($old.upstream | build)" else ", which is new" end),
          ($new | to_entries[] | select(.value | type == "array") | .key as $field
            | ($new[$field] - ($old[$field] // [])) as $added | (($old[$field] // []) - $new[$field]) as $removed
            | select(($added + $removed) | length > 0)
            | "  \($field): \($added | length) added, \($removed | length) removed",
              (if $old.upstream then ($removed[] | "    - \(.)"), ($added[] | "    + \(.)") else empty end))' \
        "$accepted" >&2
    # Written over, rather than moved, so that the baseline keeps its permissions
    cat "$accepted" > "$baseline"
    rm -f "$accepted"

    findings="$(jq -r --slurpfile baseline "$baseline" "$remaining"' | select(.severity == "REVIEW")
        | "  \(.rule) at \(.site): \(.detail)"' "$report")"
    if [[ -n "$findings" ]]; then
        log "Accepting the build doesn't resolve these, which only a fix, or an allowance with a reason, does:"
        printf '%s\n' "$findings" >&2
    fi
    # A capability that the extensions no longer report stays in question while another line has it
    findings="$(jq -r --arg line "$line" --slurpfile baseline "$baseline" '
        .findings[] | select(.rule == "capability-change" and (.site | startswith("capability "))) | .site as $key
        | [$baseline[0].lines | to_entries[] | select(.key != $line)
            | select(any(.value.capabilities[]?; startswith($key + "="))) | .key]
        | select(length > 0) | "  \($key), until the \(join(", ")) line is accepted too"' "$report")"
    if [[ -n "$findings" ]]; then
        log "The extensions no longer report these, which other lines still have:"
        printf '%s\n' "$findings" >&2
    fi
    if [[ -n "$ways" ]]; then
        log "The extensions' unit tests now expect exactly the ways of this build's JAR, which differ from the line's before; update their expectations, such as in CapabilitiesTest, where a way changed:"
        printf '%s\n' "$ways" >&2
    fi
}

# The versions of the Python tools that lint runs
RUFF_VERSION=0.16.9
TY_VERSION=0.0.84

cmd_lint() {
    local fix=false
    case "${1:-}" in
        "") ;;
        --fix) fix=true ;;
        *) die "Unknown option for lint: $1" ;;
    esac
    (( $# <= 1 )) || die "lint takes at most one option"
    command -v uv >/dev/null 2>&1 || die "lint needs uv: https://docs.astral.sh/uv/"
    local branding="$ROOT/branding" script="$ROOT/branding/generate.py" python

    if $fix; then
        # Fixes can leave code to format, so they come first. Lints that remain
        # fail the command, but only after formatting.
        local status=0
        uvx "ruff@$RUFF_VERSION" check --fix "$branding" || status=$?
        uvx "ruff@$RUFF_VERSION" format "$branding"
        (( status == 0 )) || exit "$status"
    else
        uvx "ruff@$RUFF_VERSION" format --check "$branding"
        uvx "ruff@$RUFF_VERSION" check "$branding"
    fi
    uv lock --quiet --check --script "$script"
    # ty checks against the script's own environment, with its locked dependencies
    uv sync --quiet --locked --script "$script"
    python="$(uv python find --script "$script")"
    uvx "ty@$TY_VERSION" check --project "$branding" --python "$python" --extra-search-path "$branding/stubs"
}

main() {
    local command="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "$command" in
        build) cmd_build "$@" ;;
        it) cmd_it "$@" ;;
        db) cmd_db "$@" ;;
        sources) cmd_sources "$@" ;;
        sbom) cmd_sbom "$@" ;;
        review) cmd_review "$@" ;;
        accept) cmd_accept "$@" ;;
        clean) cmd_clean "$@" ;;
        headers) exec "$ROOT/scripts/ci/license-headers.sh" "$@" ;;
        lint) cmd_lint "$@" ;;
        "" | -h | --help | help) usage ;;
        *) die "Unknown command: $command (try --help)" ;;
    esac
}

main "$@"
